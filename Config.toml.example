[database]
user = "fhirsync"
password = "fhirsyncpw"
host = "127.0.0.1"
port = 3316
schema = "oscar"

[server]
health_port = 8080
webhook_port = 8081
grpc_port = 50051

[fhir]
base_url = "http://localhost:8082/fhir"
oscar_demographic_system = "https://arsmedicatech.com/fhir/sid/oscar-demographic-no"
# token_env = "FHIR_SYNC_TOKEN"

[sync]
checkpoint_path = "/var/lib/fhir-sync/checkpoint.json"
retry_max_attempts = 5
retry_base_ms = 500
