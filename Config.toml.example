[database]
user = "fhirsync"
password = "fhirsyncpw"
host = "127.0.0.1"
port = 3316
schema = "oscar"
server_id = 4321

[server]
health_port = 8080
webhook_port = 8081
grpc_port = 50051

[fhir]
base_url = "http://localhost:8082/fhir"
oscar_demographic_system = "https://arsmedicatech.com/fhir/sid/oscar-demographic"
oscar_provider_system = "https://arsmedicatech.com/fhir/sid/oscar-provider"
oscar_appointment_system = "https://arsmedicatech.com/fhir/sid/oscar-appointment"
bc_phn_system = "https://fhir.infoway-inforoute.ca/NamingSystem/ca-bc-patient-healthcare-id"
bc_msp_practitioner_system = "https://fhir.infoway-inforoute.ca/NamingSystem/ca-bc-provider-billing-number"
# token_env = "FHIR_SYNC_TOKEN"

[oscar]
timezone = "America/Vancouver"

# Optional status overrides for site-configurable `appointment.status` codes.
# Leave a code unmapped to dead-letter it rather than guess.
# [oscar.appointment_status_map]
# a = "booked"

[sync]
checkpoint_path = "/var/lib/fhir-sync/checkpoint.json"
retry_max_attempts = 5
retry_base_ms = 500
dead_letter_path = "/var/lib/fhir-sync/dead_letter.jsonl"

# Optional: HAPI → HAPI replication (disabled by default).
# [replication]
# enabled = false
# state_dir = "/var/lib/fhir-sync"
# poll_interval_ms = 5000
# page_size = 100
#
# [[replication.nodes]]
# name = "node-a"
# base_url = "http://hapi-a:8080/fhir"
#
# [[replication.nodes]]
# name = "node-b"
# base_url = "http://hapi-b:8080/fhir"
#
# [[replication.links]]
# name = "a-to-b"
# source = "node-a"
# target = "node-b"
# mode = "mirror"
# resources = ["Patient"]
# provenance = true
